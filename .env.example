# Copie este arquivo para .env.local e preencha com sua chave.
# Nunca commite o .env.local (ele já está no .gitignore).

# Chave da API da Anthropic (Claude). Crie a sua em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: qual modelo usar para as conversas.
#   claude-opus-5    -> padrão, melhor qualidade de personagem/humor
#   claude-sonnet-5  -> mais rápido e mais barato, ótimo para conversar bastante
#   claude-haiku-4-5 -> o mais rápido/barato dos três
ANTHROPIC_MODEL=claude-opus-5
